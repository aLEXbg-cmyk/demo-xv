# ========================================================
# VARIABLES DE ENTORNO PARA MYSQL (Vercel y Local)
# Agrega estas variables en tu proyecto de Vercel:
# Settings -> Environment Variables
# ========================================================

MYSQL_HOST=tu_host_mysql.com
MYSQL_PORT=3306
MYSQL_USER=tu_usuario
MYSQL_PASSWORD=tu_contraseña
MYSQL_DATABASE=xv_lizette_db
MYSQL_SSL=true

